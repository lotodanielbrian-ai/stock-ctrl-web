# Supabase URL y Anon Key (públicas, seguras para el cliente web)
# Podés obtenerlas en el Dashboard de Supabase > Project Settings > API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Si no configuras estas variables, el sistema funcionará en modo "Offline/Demo"
# usando el localStorage del navegador.
